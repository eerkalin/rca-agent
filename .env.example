DATABASE_URL=mysql+pymysql://rca_agent:rca_agent_password@127.0.0.1:3306/rca_agent?charset=utf8mb4
# Optional legacy fallback only. New Applications should configure an LLM Connection in /ui/.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
RCA_MASTER_KEY=replace-with-fernet-key
