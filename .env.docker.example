# Copy to .env.docker and replace all placeholder secrets before starting.
# Never commit the real .env.docker file.

MYSQL_ROOT_PASSWORD=replace-me-root-password
MYSQL_DATABASE=rca_agent
MYSQL_USER=rca_agent
MYSQL_PASSWORD=replace-me-database-password

# Generate both Fernet keys independently with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
RCA_MASTER_KEY=replace-with-fernet-key

# Optional interactive authentication. Existing installations remain unauthenticated
# until AUTH_ENABLED=true is set intentionally.
AUTH_ENABLED=false
RCA_AUTH_KEY=replace-with-a-different-fernet-key
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-me-admin-password

RCA_AGENT_IMAGE=rca-agent:local
RCA_AGENT_PORT=8000

# Optional legacy fallback only. New Applications should configure an LLM Connection in the UI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
