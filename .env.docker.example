# Copy to .env.docker and replace all placeholder secrets before starting.
# Never commit the real .env.docker file.

MYSQL_ROOT_PASSWORD=replace-me-root-password
MYSQL_DATABASE=rca_agent
MYSQL_USER=rca_agent
MYSQL_PASSWORD=replace-me-database-password

# Generate with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
RCA_MASTER_KEY=replace-with-fernet-key

RCA_AGENT_IMAGE=rca-agent:local
RCA_AGENT_PORT=8000

# Optional legacy fallback only. New Applications should configure an LLM Connection in the UI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
